// 10.3.x+ release pipeline — fully independent, no kogito-pipelines / jobs.groovy dependency.
//   - No @Library, no DSL-injected env vars, no drools-deploy / drools-promote downstream jobs
//   - Create a plain "Pipeline script from SCM" job pointing at this file and run it
//     with a few parameters. Everything it needs is a parameter (with a default).
//   - Runs script/release/release-all.sh (R commit + RC tag -> build -> Nexus staging)
//
// MANDATORY parameters : RELEASE_VERSION, TAG_NAME
// Real RC run          : DEPLOY=true, PUSH_TAG=true, DRY_RUN=false

pipeline {
    agent {
        label 'ubuntu'
    }

    tools {
        maven 'maven_3.9.16'
        jdk   'jdk_17_latest'
    }

    options {
        timestamps()
        timeout(time: 360, unit: 'MINUTES')
    }

    parameters {
        string(name: 'RELEASE_VERSION', defaultValue: '', description: 'MANDATORY. Exact release version, e.g. 10.3.0', trim: true)
        string(name: 'TAG_NAME', defaultValue: '', description: 'MANDATORY. RC tag name, e.g. 10.3.0-rc1 (must start with RELEASE_VERSION and be a new tag)', trim: true)
        booleanParam(name: 'SKIP_TESTS', defaultValue: true, description: 'Skip running tests during reactor build')
        booleanParam(name: 'DEPLOY', defaultValue: true, description: 'Deploy artifacts to Apache Nexus staging')
        string(name: 'STAGING_URL', defaultValue: '', description: 'Custom Nexus staging URL (optional)')
        booleanParam(name: 'PUSH_TAG', defaultValue: true, description: 'Push the git tag to origin')
        string(name: 'EXTRA_MAVEN_OPTS', defaultValue: '', description: 'Extra Maven CLI options to pass to build.sh')
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'Dry run without making remote git or staging changes')
        booleanParam(name: 'SEND_NOTIFICATION', defaultValue: false, description: 'Send an e-mail when the pipeline finishes (requires NOTIFICATION_EMAIL)')
        string(name: 'NOTIFICATION_EMAIL', defaultValue: '', description: 'Optional. Recipient for SEND_NOTIFICATION', trim: true)

        // Jenkins IDs — defaults match the existing KIE Jenkins; override only if they differ.
        string(name: 'MAVEN_SETTINGS_CONFIG_FILE_ID', defaultValue: 'kie-release-authn-settings', description: 'Config File Provider ID of the Maven settings.xml (must define server "apache.releases.https")', trim: true)
        string(name: 'GPG_KEY_CREDS_ID', defaultValue: 'GPG_KEY_FILE', description: 'Secret FILE credential ID holding the armored GPG private key', trim: true)
        string(name: 'GPG_PASSPHRASE_CREDS_ID', defaultValue: 'GPG_KEY_PASSPHRASE', description: 'Secret TEXT credential ID holding the GPG key passphrase', trim: true)
        string(name: 'GIT_PUSH_CREDS_ID', defaultValue: '84811880-2025-45b6-a44c-2f33bef30ad2', description: 'Username/password credential ID used to push the RC tag to GitHub', trim: true)
        string(name: 'GIT_AUTHOR_NAME', defaultValue: 'Apache KIE Release Bot', description: 'git user.name for the R commit', trim: true)
        string(name: 'GIT_AUTHOR_EMAIL', defaultValue: 'dev@kie.apache.org', description: 'git user.email for the R commit', trim: true)
    }

    stages {
        stage('Initialize & Validate') {
            steps {
                script {
                    if (!params.RELEASE_VERSION?.trim()) {
                        error 'RELEASE_VERSION parameter is mandatory (e.g. 10.3.0)'
                    }
                    if (!params.TAG_NAME?.trim()) {
                        error 'TAG_NAME parameter is mandatory (e.g. 10.3.0-rc1)'
                    }
                    if (!params.TAG_NAME.startsWith(params.RELEASE_VERSION)) {
                        error "TAG_NAME '${params.TAG_NAME}' must start with RELEASE_VERSION '${params.RELEASE_VERSION}'"
                    }
                    currentBuild.displayName = "Release ${params.RELEASE_VERSION} (${params.TAG_NAME})"
                }
            }
        }

        stage('Execute Release Scripts') {
            steps {
                // The Maven settings id is a Config File Provider id (not a secret) and is
                // exposed as MAVEN_SETTINGS_FILE. GPG key/passphrase and the GitHub push
                // credential are real credentials and use withCredentials.
                configFileProvider([configFile(fileId: params.MAVEN_SETTINGS_CONFIG_FILE_ID, variable: 'MAVEN_SETTINGS_FILE')]) {
                    withCredentials([
                        file(credentialsId: params.GPG_KEY_CREDS_ID, variable: 'GPG_KEY_FILE_PATH'),
                        string(credentialsId: params.GPG_PASSPHRASE_CREDS_ID, variable: 'MAVEN_GPG_PASSPHRASE'),
                        usernamePassword(credentialsId: params.GIT_PUSH_CREDS_ID, usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')
                    ]) {
                        script {
                            // Import the signing key so the apache-release profile can sign
                            // artifacts. Passphrase is supplied later via MAVEN_GPG_PASSPHRASE.
                            sh '''#!/usr/bin/env bash
                            set -euo pipefail
                            gpg --batch --pinentry-mode=loopback --import "$GPG_KEY_FILE_PATH"
                            '''

                            // Configure Git identity for the R commit and authenticate the
                            // raw `git push` in 02-rc-commit.sh. The credential helper reads
                            // the token from the environment at push time, never from disk.
                            sh """#!/usr/bin/env bash
                            set -euo pipefail
                            git config user.email "${params.GIT_AUTHOR_EMAIL}"
                            git config user.name  "${params.GIT_AUTHOR_NAME}"
                            git config --local credential.helper '!f() { echo username=\$GITHUB_USER; echo password=\$GITHUB_TOKEN; }; f'
                            """

                            // Build the argv array safely — each parameter is a
                            // separate shell word, no string concatenation or eval.
                            def releaseArgs = [
                                './script/release/release-all.sh',
                                '--version', params.RELEASE_VERSION,
                                '--tag',     params.TAG_NAME
                            ]
                            if (params.SKIP_TESTS)             releaseArgs << '--skip-tests'
                            if (params.DEPLOY)                 releaseArgs << '--deploy'
                            if (params.STAGING_URL?.trim())    releaseArgs += ['--staging-url', params.STAGING_URL.trim()]
                            if (params.PUSH_TAG)               releaseArgs << '--push-tag'
                            if (params.EXTRA_MAVEN_OPTS?.trim()) releaseArgs += ['--maven-opts', params.EXTRA_MAVEN_OPTS.trim()]
                            if (params.DRY_RUN)                releaseArgs << '--dry-run'

                            // MAVEN_SETTINGS_FILE is injected by configFileProvider above.
                            // MAVEN_GPG_PASSPHRASE is already in env from withCredentials
                            // and is read by the GPG plugin directly (not a CLI arg).
                            withEnv(["MAVEN_SETTINGS=${MAVEN_SETTINGS_FILE}"]) {
                                sh """#!/usr/bin/env bash
                                set -euo pipefail
                                chmod +x script/release/*.sh
                                ${releaseArgs.collect { "'${it.replace("'", "'\\''")}'" }.join(' ')}
                                """
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            script {
                sendNotification()
            }
        }
        unsuccessful {
            sendErrorNotification()
        }
    }
}

void sendNotification() {
    if (params.SEND_NOTIFICATION && params.NOTIFICATION_EMAIL) {
        mail(
            to: params.NOTIFICATION_EMAIL,
            subject: "[SUCCESS] Release ${params.RELEASE_VERSION} (${params.TAG_NAME}) Drools - Build ${BUILD_TAG}",
            body: "Release pipeline succeeded.\n\nBuild URL: ${BUILD_URL}"
        )
    } else {
        echo 'No notification sent per configuration'
    }
}

void sendErrorNotification() {
    if (params.SEND_NOTIFICATION && params.NOTIFICATION_EMAIL) {
        mail(
            to: params.NOTIFICATION_EMAIL,
            subject: "[FAILURE] Release ${params.RELEASE_VERSION} (${params.TAG_NAME}) Drools - Build ${BUILD_TAG}",
            body: "Release pipeline failed.\n\nBuild URL: ${BUILD_URL}"
        )
    } else {
        echo 'No notification sent per configuration'
    }
}
