// 10.3.x+ promote pipeline — no kogito-pipelines dependency.
//   - agent { label 'ubuntu' } + tools block instead of docker { image AGENT_DOCKER_BUILDER_IMAGE }
//   - 'Tag final release' stage delegates to 05-tag-release.sh (no shared library)
//   - 'Create release' stage uses 'gh' CLI instead of githubscm shared-library helpers
//   - 'Upload drools binaries and documentation' stage uses 03-build.sh directly
//   - @Library removed entirely

deployProperties = [:]

pipeline {
    agent {
        label 'ubuntu'
    }

    tools {
        maven 'maven_3.9.16'
        jdk   'jdk_17_latest'
    }

    options {
        timestamps()
        timeout(time: 180, unit: 'MINUTES')
    }

    environment {
        DROOLS_CI_EMAIL_TO = credentials("${JENKINS_EMAIL_CREDS_ID}")
    }

    stages {
        stage('Initialization') {
            steps {
                script {
                    cleanWs()

                    if (params.DISPLAY_NAME != '') {
                        currentBuild.displayName = params.DISPLAY_NAME
                    }

                    readDeployProperties()

                    assert getProjectVersion() : 'PROJECT_VERSION is required'
                    // Build branch must match the release version stream (e.g. 10.3.0 -> 10.3.x)
                    def expectedBranch = getProjectVersion().replaceFirst(/(\d+\.\d+)\.\d+.*/, '$1.x')
                    assert getBuildBranch() == expectedBranch : \
                        "BUILD_BRANCH_NAME '${getBuildBranch()}' does not match version '${getProjectVersion()}' (expected '${expectedBranch}')"
                    // GIT_TAG must be the approved RC tag; the final tag is derived from it.
                    assert getRcTag() ==~ /.+-rc[0-9]+/ : \
                        "GIT_TAG must be the approved RC tag (e.g. 10.3.0-rc2), got '${getRcTag()}'"
                }
            }
        }

        stage('Merge deploy PR') {
            // NOTE: tagLatest() removed here intentionally.
            // In the 103xplus flow the final release tag is created by the
            // separate "Tag final release" stage below, which delegates to
            // 05-tag-release.sh so the tag always points to the approved
            // RC commit — NOT the current branch tip.  Calling tagLatest()
            // here would create a duplicate tag at the wrong commit.
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: getGitAuthorPushCredsId(), usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                        def prLink = getDeployPrLink()
                        if (prLink?.trim()) {
                            sh """#!/usr/bin/env bash
                            set -euo pipefail
                            git config --local credential.helper '!f() { echo username=\$GITHUB_USER; echo password=\$GITHUB_TOKEN; }; f'
                            gh pr review  '${prLink}' --approve
                            gh pr merge   '${prLink}' --merge --auto
                            """
                        }
                        dir(getRepoName()) {
                            checkoutRepo()
                        }
                    }
                }
            }
        }

        stage('Tag final release') {
            // Delegate final-tag creation to 05-tag-release.sh so the release tag
            // always points to the approved RC commit — NOT the current branch tip.
            // This matches the documented strategy: the R commit lives under the RC
            // tag only; the development branch is never disturbed.
            // Runs before 'Create release' so the GitHub release attaches to this
            // tag instead of creating one at the branch tip.
            steps {
                withCredentials([
                    usernamePassword(credentialsId: env.GIT_AUTHOR_PUSH_CREDS_ID, usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')
                ]) {
                    script {
                        dir(getRepoName()) {
                            sh """#!/usr/bin/env bash
                            set -euo pipefail
                            git config user.email "${env.GIT_AUTHOR_EMAIL ?: 'dev@kie.apache.org'}"
                            git config user.name  "${env.GIT_AUTHOR ?: 'Apache KIE Release Bot'}"
                            git config --local credential.helper '!f() { echo username=\$GITHUB_USER; echo password=\$GITHUB_TOKEN; }; f'
                            # Fetch the RC tag so the script can resolve it.
                            git fetch origin "refs/tags/${getRcTag()}:refs/tags/${getRcTag()}"
                            chmod +x script/release/05-tag-release.sh
                            ./script/release/05-tag-release.sh --rc-tag "${getRcTag()}" --push
                            """
                        }
                    }
                }
            }
        }

        stage('Create release') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: getGitAuthorPushCredsId(), usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                        sh """#!/usr/bin/env bash
                        set -euo pipefail
                        git config --local credential.helper '!f() { echo username=\$GITHUB_USER; echo password=\$GITHUB_TOKEN; }; f'

                        # Delete any pre-existing release so we can re-create it cleanly.
                        if gh release view '${getGitTag()}' --repo '${getGitAuthor()}/${getRepoName()}' &>/dev/null; then
                            gh release delete '${getGitTag()}' \
                                --repo '${getGitAuthor()}/${getRepoName()}' \
                                --yes
                        fi

                        # Derive the previous tag for release-note generation.
                        PREV_TAG="\$(git tag --sort=-version:refname | grep -v '^${getGitTag()}\$' | head -1 || true)"

                        gh release create '${getGitTag()}' \
                            --repo '${getGitAuthor()}/${getRepoName()}' \
                            --target '${getBuildBranch()}' \
                            --title   '${getGitTag()}' \
                            --generate-notes \
                            \${PREV_TAG:+--notes-start-tag "\${PREV_TAG}"}
                        """
                    }
                }
            }
        }

        stage('Upload drools binaries and documentation') {
            when {
                expression { return isMainStream() }
            }
            steps {
                script {
                    dir(getRepoName()) {
                        sh """#!/usr/bin/env bash
                        set -euo pipefail
                        chmod +x script/release/03-build.sh
                        ./script/release/03-build.sh --skip-tests
                        """

                        if (isNotTestingBuild()) {
                            sshagent(['drools-filemgmt']) {
                                sh """#!/usr/bin/env bash
                                set -euo pipefail
                                chmod +x script/release/upload_filemgmt.sh
                                ./script/release/upload_filemgmt.sh '${getProjectVersion()}'
                                """
                            }
                        } else {
                            echo 'No uploadFileMgmt due to testing build'
                        }
                    }
                }
            }
        }
    }
    post {
        unsuccessful {
            sendNotification()
        }
        cleanup {
            cleanWs()
        }
    }
}

void sendNotification() {
    if (params.SEND_NOTIFICATION) {
        mail(
            to: env.DROOLS_CI_EMAIL_TO,
            subject: "[FAILURE] Promote [${getBuildBranch()}] Drools - Build ${BUILD_TAG}",
            body: "Promote pipeline failed.\n\nBuild URL: ${BUILD_URL}"
        )
    } else {
        echo 'No notification sent per configuration'
    }
}

//////////////////////////////////////////////////////////////////////////////
// Deployment properties
//////////////////////////////////////////////////////////////////////////////

void readDeployProperties() {
    String deployUrl = params.DEPLOY_BUILD_URL
    if (deployUrl != '') {
        if (!deployUrl.endsWith('/')) {
            deployUrl += '/'
        }
        sh "wget ${deployUrl}artifact/${PROPERTIES_FILE_NAME} -O ${PROPERTIES_FILE_NAME}"
        deployProperties = readProperties file: PROPERTIES_FILE_NAME
        // echo all properties
        echo deployProperties.collect { entry -> "${entry.key}=${entry.value}" }.join('\n')
    }
}

boolean hasDeployProperty(String key) {
    return deployProperties[key] != null
}

String getDeployProperty(String key) {
    if (hasDeployProperty(key)) {
        return deployProperties[key]
    }
    return ''
}

String getParamOrDeployProperty(String paramKey, String deployPropertyKey) {
    if (params[paramKey] != '') {
        return params[paramKey]
    }
    return getDeployProperty(deployPropertyKey)
}

//////////////////////////////////////////////////////////////////////////////
// Getter / Setter
//////////////////////////////////////////////////////////////////////////////

String getRepoName() {
    return env.REPO_NAME
}

String getProjectVersion() {
    return getParamOrDeployProperty('PROJECT_VERSION', 'project.version')
}

// Approved RC tag to promote (e.g. 10.3.0-rc2). Mandatory, validated in Initialization.
String getRcTag() {
    return params.GIT_TAG ?: ''
}

// Final release tag, derived from the RC tag (e.g. 10.3.0-rc2 -> 10.3.0).
String getGitTag() {
    return getRcTag().replaceFirst(/-rc[0-9]+$/, '')
}

String getBuildBranch() {
    return params.BUILD_BRANCH_NAME
}

String getGitAuthor() {
    return env.GIT_AUTHOR
}

String getGitAuthorCredsId() {
    return env.GIT_AUTHOR_CREDS_ID
}

String getGitAuthorPushCredsId() {
    return env.GIT_AUTHOR_PUSH_CREDS_ID
}

String getDeployPrLink() {
    return getDeployProperty("${getRepoName()}.pr.link")
}

//////////////////////////////////////////////////////////////////////////////
// Git
//////////////////////////////////////////////////////////////////////////////

void checkoutRepo() {
    deleteDir()
    checkout([$class: 'GitSCM',
        branches: [[name: "*/${getBuildBranch()}"]],
        userRemoteConfigs: [[
            url: "https://github.com/${getGitAuthor()}/${getRepoName()}.git",
            credentialsId: getGitAuthorCredsId()
        ]]
    ])
    sh "git checkout ${getBuildBranch()}"
}

boolean isNotTestingBuild() {
    return getGitAuthor() == 'apache'
}

boolean isMainStream() {
    return env.DROOLS_STREAM == 'main'
}